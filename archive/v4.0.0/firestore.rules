rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function schoolShape() {
      return request.resource.data.keys().hasAll(['name', 'feeMode', 'rows', 'ownerUid', 'searchableName', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.feeMode in ['termly', 'annual']
        && request.resource.data.rows is list
        && request.resource.data.ownerUid is string
        && request.resource.data.searchableName is string
        && request.resource.data.updatedAt is string;
    }

    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && schoolShape()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && schoolShape();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
